---
// src/layouts/ProductionLayout.astro
import '../styles/global.css';
import Navbar from '../components/NavBar.astro';
import type { ImageMetadata } from 'astro';
import { Image, getImage } from 'astro:assets';

const { frontmatter } = Astro.props;

// 1. Recherche dynamique des images dans src/assets
const allImages = import.meta.glob<{ default: ImageMetadata }>('/src/assets/**/*.{jpeg,jpg,png,gif,webp,JPG,PNG}');

function resolveAssetPath(path: string) {
  if (!path) return null;
  const filename = path.split('/').pop();
  const matchedKey = Object.keys(allImages).find((key) => key.endsWith(`/${filename}`));
  return matchedKey || null;
}

// Image Hero (Fond de bannières)
let bgImageUrl = frontmatter.bgImage || '';
if (bgImageUrl) {
  const bgKey = resolveAssetPath(bgImageUrl);
  if (bgKey && allImages[bgKey]) {
    const bgModule = await allImages[bgKey]();
    const optimizedBg = await getImage({ src: bgModule.default });
    bgImageUrl = optimizedBg.src;
  }
}

// Image d'Affiche
let posterMetadata: ImageMetadata | null = null;
let posterFallbackUrl: string | null = null;

if (frontmatter.poster) {
  const posterKey = resolveAssetPath(frontmatter.poster);
  if (posterKey && allImages[posterKey]) {
    const posterModule = await allImages[posterKey]();
    posterMetadata = posterModule.default;
  } else {
    posterFallbackUrl = frontmatter.poster;
  }
}

// Convertit les liens Markdown [Texte](url) dans le frontmatter en HTML
function parseMarkdownLinks(text: string) {
  if (!text) return '';
  return text.replace(
    /\[([^\]]+)\]\(([^)]+)\)/g, 
    '<a href="$2" target="_blank" rel="noopener noreferrer" class="underline hover:opacity-70 transition-opacity">$1</a>'
  );
}
---

<!doctype html>
<html lang="fr" class="h-full">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>{frontmatter.title} — La Troupe du Rez</title>
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400..900;1,400..900&family=Inter:wght@200;300;400;500&display=swap" rel="stylesheet">
</head>
<body class="bg-neutral-950 text-white font-sans antialiased selection:bg-white selection:text-black min-h-full relative">
  
  <!-- 0. Arrière-plan fixe calé SOUS la Navbar (pour ne pas couper le haut) -->
  {bgImageUrl && (
    <div class="fixed inset-x-0 bottom-0 top-20 md:top-24 -z-10 overflow-hidden pointer-events-none">
      <img 
        src={bgImageUrl} 
        alt="" 
        class="w-full h-full object-cover object-top opacity-40 filter brightness-90"
      />
      <div class="absolute inset-0 bg-gradient-to-b from-neutral-950/80 via-neutral-950/40 to-neutral-950"></div>
    </div>
  )}

  <!-- Navbar -->
  <Navbar />

  <!-- Contenu principal défilant sans cartes -->
  <main class="relative z-10 max-w-4xl mx-auto px-6 pt-24 md:pt-32 pb-24 space-y-20 md:space-y-28">
    
    <!-- En-tête / Titre du spectacle -->
    <header class="text-center space-y-4">
      <span class="text-xs uppercase tracking-[0.35em] text-neutral-400 block font-light">Spectacle</span>
      <h1 class="text-4xl md:text-7xl font-serif text-white font-normal tracking-tight leading-tight drop-shadow-lg">{frontmatter.title}</h1>
    </header>

    <!-- Section Affiche & Synopsis -->
    <section class="space-y-10  pt-16 md:pt-20">
      <h2 class="text-xs font-semibold uppercase tracking-[0.3em] text-neutral-400">Résumé</h2>
      
      <div class="grid grid-cols-1 md:grid-cols-12 gap-10 md:gap-14 items-start">
        {(posterMetadata || posterFallbackUrl) && (
          <div class="md:col-span-5">
            {posterMetadata ? (
              <Image 
                src={posterMetadata} 
                alt={`Affiche ${frontmatter.title}`} 
                class="w-full h-auto object-cover shadow-2xl"
              />
            ) : (
              <img 
                src={posterFallbackUrl!} 
                alt={`Affiche ${frontmatter.title}`} 
                class="w-full h-auto object-cover shadow-2xl"
              />
            )}
          </div>
        )}
        
        <div class={`${(posterMetadata || posterFallbackUrl) ? 'md:col-span-7' : 'md:col-span-12'}`}>
          <div class="prose prose-invert prose-lg max-w-none font-light leading-relaxed text-neutral-200 space-y-6">
            <slot /> 
          </div>
        </div>
      </div>
    </section>

    <!-- Section Générique / Distribution -->
    {frontmatter.generic && (
      <section class="space-y-10 pt-16 md:pt-20">
        <h2 class="text-xs font-semibold uppercase tracking-[0.3em] text-neutral-400">Générique</h2>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-x-12 gap-y-3">
          {frontmatter.generic.map((item: any) => (
            <div class="py-2.5 border-b border-white/10 flex justify-between items-baseline gap-4">
              <span class="text-xs uppercase tracking-wider text-neutral-400 font-medium">{item.role}</span>
              <span class="text-sm font-light text-white text-right">{item.name}</span>
            </div>
          ))}
        </div>
      </section>
    )}

    <!-- Dates & Billetterie -->
    {(frontmatter.representations || frontmatter.reservation) && (
      <section class="space-y-12 pt-16 md:pt-20">
        
        {frontmatter.representations && (
          <div class="space-y-8">
            <h2 class="text-xs font-semibold uppercase tracking-[0.3em] text-neutral-400">Dates & Représentations</h2>
            <ul class="divide-y divide-white/10">
              {frontmatter.representations.map((rep: any) => (
                <li class="py-4 flex flex-col sm:flex-row sm:items-center justify-between gap-2">
                  <span class="font-serif text-lg text-white">{rep.date}</span>
                  <span class="text-sm font-light text-neutral-300">{rep.location}</span>
                </li>
              ))}
            </ul>
          </div>
        )}

        {frontmatter.reservation && (
          <div class="pt-6 text-center space-y-6">
            <p class="font-light text-neutral-300 text-sm max-w-md mx-auto">{frontmatter.reservation.text}</p>
            <div>
              <a 
                href={frontmatter.reservation.link} 
                target="_blank" 
                rel="noopener noreferrer" 
                class="inline-block bg-white text-black text-xs uppercase tracking-[0.25em] font-medium px-10 py-4 hover:bg-neutral-200 transition-colors shadow-lg"
              >
                Réserver vos places
              </a>
            </div>
          </div>
        )}
      </section>
    )}

    <!-- Citations & Extrait de Presse -->
    {frontmatter.quotes && (
      <section class="space-y-12 pt-16 md:pt-20">
        <h2 class="text-xs font-semibold uppercase tracking-[0.3em] text-neutral-400">Citations</h2>
        <div class="space-y-12 max-w-3xl mx-auto">
          {frontmatter.quotes.map((quote: any) => (
            <blockquote class="text-center space-y-4">
              <p class="font-serif italic text-xl md:text-2xl text-neutral-100 leading-relaxed">
                « {quote.text} »
              </p>
              {quote.author && (
                <cite class="block text-xs uppercase tracking-[0.2em] text-neutral-400 not-italic">
                  — {quote.author}
                </cite>
              )}
            </blockquote>
          ))}
        </div>
      </section>
    )}

    <!-- Pied de page : Dossier & Partenaires -->
    {(frontmatter.annex || frontmatter.sponsoring) && (
      <footer class=" pt-16 md:pt-20 text-center space-y-12">
        
        {frontmatter.annex && (
          <div>
            <a 
              href="#" 
              class="inline-block text-xs uppercase tracking-[0.2em] text-white border-b border-white pb-1 hover:opacity-70 transition-opacity"
            >
              Télécharger le dossier de présentation (PDF)
            </a>
          </div>
        )}

        {frontmatter.sponsoring && (
          <div class="space-y-4 pt-4">
            <span class="text-[10px] uppercase tracking-[0.3em] text-neutral-400 block font-medium">
              Soutiens & Partenaires
            </span>
            <div class="space-y-1 max-w-xl mx-auto">
              {frontmatter.sponsoring.map((sponsor: any) => (
                <p 
                  class="text-xs font-light text-neutral-400 leading-relaxed" 
                  set:html={parseMarkdownLinks(sponsor.name)} 
                />
              ))}
            </div>
          </div>
        )}

      </footer>
    )}

  </main>

</body>
</html>