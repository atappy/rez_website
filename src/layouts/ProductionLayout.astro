---
// src/layouts/ProductionLayout.astro
import type { CollectionEntry } from 'astro:content';
import BaseLayout from './BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
import Synopsis from '../components/production/Synopsis.astro';
import Cast from '../components/production/Cast.astro';
import DatesAndBooking from '../components/production/DatesAndBooking.astro';
import Quotes from '../components/production/Quotes.astro';
import Credits from '../components/production/Credits.astro';

interface Props {
  frontmatter: CollectionEntry<'pieces'>['data'];
}

const { frontmatter } = Astro.props;
---

<BaseLayout title={frontmatter.title} backgroundImage={frontmatter.bgImage}>
  <PageHeader title={frontmatter.title} />

  <Synopsis title={frontmatter.title} poster={frontmatter.poster}>
    <slot />
  </Synopsis>

  {frontmatter.generic && <Cast items={frontmatter.generic} />}

  {(frontmatter.representations || frontmatter.reservation) && (
    <DatesAndBooking representations={frontmatter.representations} reservation={frontmatter.reservation} />
  )}

  {frontmatter.quotes && <Quotes quotes={frontmatter.quotes} />}

  {(frontmatter.annex || frontmatter.sponsoring) && (
    <Credits annex={frontmatter.annex} sponsoring={frontmatter.sponsoring} />
  )}
</BaseLayout>
