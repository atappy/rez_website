---
const footerLinks = [
    {label: 'Dernier spectacle', href: '/'},
    {label: 'La Troupe', href: '/presentations/troupe'},
    {label: 'Les membres', href: '/presentations/membres'},
];
---

<footer class="site-footer site-footer-dark mt-auto w-full">
    <div class="max-w-6xl mx-auto px-6 py-8">
        <div class="grid grid-cols-1 md:grid-cols-3 gap-6 md:gap-8">

            <div class="space-y-1.5">
                <h3 class="font-serif text-lg font-normal tracking-tight">La Troupe du Rez</h3>
                <p class="site-footer-text site-footer-text-dark !mx-0 text-xs">
                    Théâtre & Création
                </p>
            </div>

            <div class="space-y-1.5">
                <h4 class="site-footer-heading site-footer-heading-dark text-xs uppercase tracking-wider">
                    Navigation
                </h4>
                <ul class="space-y-1 text-xs font-light">
                    {footerLinks.map((link) => (
                            <li>
                                <a href={link.href} class="hover:underline transition-all">
                                    {link.label}
                                </a>
                            </li>
                    ))}
                </ul>
            </div>

            <div class="space-y-1.5">
                <h4 class="site-footer-heading site-footer-heading-dark text-xs uppercase tracking-wider">
                    Newsletter
                </h4>
                <p class="site-footer-text site-footer-text-dark !mx-0 text-xs">
                    Restez informé·e de nos prochains spectacles.
                </p>

                <form
                        id="newsletter-form"
                        action="/api/newsletter"
                        method="POST"
                        class="newsletter-form pt-1"
                >
                    <input
                            type="email"
                            name="email"
                            placeholder="votre@email.ch"
                            required
                            class="newsletter-input text-xs"
                            aria-label="Adresse email pour la newsletter"
                    />
                    <button type="submit" class="newsletter-btn" aria-label="S'inscrire">
                        <svg class="w-3.5 h-3.5" fill="none" stroke="currentColor" viewBox="0 0 24 24">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2"
                                  d="M14 5l7 7m0 0l-7 7m7-7H3"></path>
                        </svg>
                    </button>
                </form>
                <p id="newsletter-status" class="text-xs mt-1.5 font-light hidden"></p>
            </div>

        </div>

        <div class="site-footer-meta site-footer-meta-dark !mt-6 !pt-4 text-xs">
            <p>© {new Date().getFullYear()} La Troupe du Rez. Tous droits réservés.</p>
            <p>Photos : Claude Dussez</p>
            <div class="site-footer-meta-links flex items-center gap-4">
                <a href="/contact" class="site-footer-meta-link">Contact</a>
                <a
                        href="https://instagram.com/troupe.du.rez/"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="site-footer-meta-link flex items-center gap-1 hover:underline"
                        aria-label="Instagram"
                >
                    <svg class="w-3.5 h-3.5 inline-block" fill="currentColor" viewBox="0 0 24 24">
                        <path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zm0-2.163c-3.259 0-3.667.014-4.947.072-4.358.2-6.78 2.618-6.98 6.98-.059 1.281-.073 1.689-.073 4.948 0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98 1.281.058 1.689.072 4.948.072 3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98-1.281-.059-1.69-.073-4.949-.073zm0 5.838c-3.403 0-6.162 2.759-6.162 6.162s2.759 6.163 6.162 6.163 6.162-2.759 6.162-6.163c0-3.403-2.759-6.162-6.162-6.162zm0 10.162c-2.209 0-4-1.79-4-4 0-2.209 1.791-4 4-4s4 1.791 4 4c0 2.21-1.791 4-4 4zm6.406-11.845c-.796 0-1.441.645-1.441 1.44s.645 1.44 1.441 1.44c.795 0 1.439-.645 1.439-1.44s-.644-1.44-1.439-1.44z"/>
                    </svg>
                    <span>Instagram</span>
                </a>
            </div>
        </div>
    </div>
</footer>

<script>
    function setupNewsletter() {
        const form = document.getElementById('newsletter-form') as HTMLFormElement;
        const status = document.getElementById('newsletter-status');

        if (!form || form.dataset.listener === 'true') return;
        form.dataset.listener = 'true';

        form.addEventListener('submit', async (e) => {
            e.preventDefault();
            const btn = form.querySelector('button') as HTMLButtonElement;
            if (btn) btn.disabled = true;

            try {
                const response = await fetch('/api/newsletter', {
                    method: 'POST',
                    body: new FormData(form),
                });

                if (response.ok) {
                    form.reset();
                    if (status) {
                        status.textContent = 'Inscription réussie !';
                        status.className = 'text-xs mt-1.5 text-emerald-400 block';
                    }
                } else {
                    if (status) {
                        status.textContent = 'Erreur lors de l\'envoi.';
                        status.className = 'text-xs mt-1.5 text-red-400 block';
                    }
                }
            } catch {
                if (status) {
                    status.textContent = 'Erreur de connexion.';
                    status.className = 'text-xs mt-1.5 text-red-400 block';
                }
            } finally {
                if (btn) btn.disabled = false;
            }
        });
    }

    setupNewsletter();
    document.addEventListener('astro:page-load', setupNewsletter);
</script>