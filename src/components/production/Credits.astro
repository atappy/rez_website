---
interface Props {
  annex?: string[];
  sponsoring?: { name: string }[];
}

const { annex, sponsoring } = Astro.props;

function parseMarkdownLinks(text: string) {
  return text.replace(
    /\[([^\]]+)\]\(([^)]+)\)/g,
    '<a href="$2" target="_blank" rel="noopener noreferrer" class="underline hover:opacity-70 transition-opacity">$1</a>',
  );
}
---

<footer class="content-section text-center space-y-12">
  {annex && (
    <div class="space-y-2 reveal-up">
      <span class="text-[12px] uppercase tracking-[0.3em] text-neutral-400 block font-medium">
        Ressources
      </span>
      <div class="space-y-1 max-w-xl mx-auto">
        {annex.map((line) => (
          <p
            class="text-s font-light text-neutral-200 leading-relaxed"
            set:html={parseMarkdownLinks(line)}
          />
        ))}
      </div>
    </div>
  )}

  {sponsoring && (
    <div class="space-y-4 pt-4 reveal-up">
      <span class="text-[12px] uppercase tracking-[0.3em] text-neutral-400 block font-medium">
        Soutiens & Partenaires
      </span>
      <div class="space-y-1 max-w-xl mx-auto">
        {sponsoring.map((sponsor) => (
          <p
            class="text-s font-light text-neutral-200 leading-relaxed"
            set:html={parseMarkdownLinks(sponsor.name)}
          />
        ))}
      </div>
    </div>
  )}
</footer>
