---
interface Props {
  title: string;
}

const { title } = Astro.props;
---

<header class="text-center space-y-4">
  <span class="text-xs uppercase tracking-[0.35em] text-neutral-400 block font-light">Spectacle</span>
  <h1 class="text-4xl md:text-7xl font-serif text-white font-normal tracking-tight leading-tight drop-shadow-lg">{title}</h1>
</header>
