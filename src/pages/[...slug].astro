---
import { getCollection, render } from 'astro:content';
import ProductionLayout from '../layouts/ProductionLayout.astro';

export async function getStaticPaths() {
  const pieces = await getCollection('pieces');

  return pieces.map((piece) => {
    const rawRoute = piece.data.route;

    let slug: string | undefined;

    if (rawRoute === '/' || rawRoute === '') {
      slug = undefined;
    } else if (rawRoute.startsWith('/')) {
      slug = rawRoute.slice(1);
    } else {
      slug = rawRoute;
    }

    return {
      params: { slug },
      props: { piece },
    };
  });
}

const { piece } = Astro.props;
const { Content } = await render(piece);
---

<ProductionLayout frontmatter={piece.data}>
  <Content />
</ProductionLayout>